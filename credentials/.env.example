DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_ADMIN_URL_PATH=change-me-obfuscated-admin-path
DASHBOARD_URL_PATH=change-me-obfuscated-dashboard-path

COOKIE_ENCRYPTION_KEY=exactly-32-bytes-long-secret-key
DYNAMIC_CSRF_TRUSTED_ORIGIN_REGEXES=^https://([a-zA-Z0-9-]+\.)?example\.com$

DB_NAME=tamerhosny__development__db
DB_USER=tamerhosny__development__user
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

CORS_ALLOWED_ORIGINS=http://localhost:5173

EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@example.com

GOOGLE_OAUTH_CLIENT_ID=change-me.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=change-me
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8600/auth/google/callback/

# Web Push - generate a real pair with `python manage.py generate_vapid_keys`.
# Empty means the feature is off (no bell icon, no sends).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIM_EMAIL=no-reply@example.com

# LLM access for auto-classifying song genre/mood (see
# backend.main_app.shared_utils.llm_providers). Tried in order - Gemini,
# then Groq, then OpenRouter. Empty means that provider is skipped;
# classification does nothing at all until at least one is set.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
